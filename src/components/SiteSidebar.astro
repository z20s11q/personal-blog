---
import { domainLabel } from '../data/domains';
import { filterByTag, type Entry } from '../data/entries';

interface Props {
  entries: Entry[];
  domain?: string;
}

const { entries, domain } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const list = domain ? filterByTag(entries, domain) : [];
const label = domain ? domainLabel(domain) : '';
const isCurrent = (entry: Entry) => entry.href !== base && path.startsWith(entry.href);
const contains = (entry: Entry) => isCurrent(entry) || entry.children.some(isCurrent);
const current = (entry: Entry) => (isCurrent(entry) ? 'page' : undefined);
---

{domain && (
  <aside class="site-sidebar">
    <details class="sidebar-toggle" open data-sidebar-toggle>
      <summary>{label}</summary>
      <nav class="sidebar-scroll" aria-label={label} data-sidebar-scroll>
        <ul class="side-list">
          {list.map((entry) => entry.children.length > 0 ? (
            <li>
              <details class="side-collection" open={contains(entry)}>
                <summary><a href={entry.href} aria-current={current(entry)}>{entry.title}</a></summary>
                <ul>{entry.children.map((child) => <li><a href={child.href} aria-current={current(child)}>{child.title}</a></li>)}</ul>
              </details>
            </li>
          ) : (
            <li><a class="side-leaf" href={entry.href} aria-current={current(entry)}>{entry.title}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </aside>
)}

<script>
  const mobile = matchMedia('(max-width: 900px)');
  const toggle = document.querySelector<HTMLDetailsElement>('[data-sidebar-toggle]');
  const scroller = document.querySelector<HTMLElement>('[data-sidebar-scroll]');
  if (toggle && scroller) {
    toggle.open = !mobile.matches;
    mobile.addEventListener('change', (event) => { toggle.open = !event.matches; });
    toggle.querySelector('summary')!.addEventListener('click', (event) => { if (!mobile.matches) event.preventDefault(); });
    const active = scroller.querySelector<HTMLElement>('a[aria-current="page"]');
    if (active && !mobile.matches) scroller.scrollTop = Math.max(0, active.offsetTop - scroller.clientHeight / 3);
  }
</script>

<style>
  .site-sidebar { position: sticky; top: var(--header-h); align-self: start; max-height: calc(100vh - var(--header-h)); min-width: 0; padding: 16px 0 12px; background: var(--sidebar); border-right: 1px solid var(--divider); }
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }
  .sidebar-toggle > summary { display: none; }
  .sidebar-scroll {
    max-height: min(560px, calc(100vh - var(--header-h) - 40px));
    padding: 4px 16px 8px 18px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    font-size: 14px;
    line-height: 1.5;
  }
  ul { margin: 0; padding: 0; list-style: none; }
  a { color: var(--muted); }
  a:hover { color: var(--ink); }
  a[aria-current="page"] { color: var(--accent); font-weight: 700; }

  .side-list > li > a,
  .side-collection > summary { display: flex; align-items: baseline; gap: 8px; padding: 6px 4px; }
  .side-leaf { padding-left: 16px !important; }

  .side-collection > summary::before {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(-45deg) translate(-1px, -1px);
    transition: transform .15s;
  }
  .side-collection[open] > summary::before { transform: rotate(45deg) translate(-1px, -1px); }
  .side-collection > summary a { flex: 1; color: var(--text); }
  .side-collection > summary a[aria-current="page"] { color: var(--accent); }
  .side-collection > ul { margin: 0 0 6px 17px; padding-left: 10px; border-left: 1px solid var(--line); }
  .side-collection > ul a { display: block; padding: 4px 4px; font-size: 13.5px; }

  @media (max-width: 900px) {
    .site-sidebar { position: static; max-height: none; padding: 0 var(--page-x); border-right: 0; border-bottom: 1px solid var(--divider); }
    .sidebar-toggle > summary { display: flex; align-items: center; justify-content: space-between; min-height: 48px; color: var(--ink); font-size: 15px; font-weight: 700; }
    .sidebar-toggle > summary::after { content: ""; width: 8px; height: 8px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: translateY(-2px) rotate(45deg); transition: transform .15s; }
    .sidebar-toggle[open] > summary::after { transform: translateY(2px) rotate(-135deg); }
    .sidebar-scroll { max-height: 320px; }
  }
</style>
