<div class="body-edge" data-edge="left" role="separator" aria-orientation="vertical" tabindex="0" aria-label="调整正文宽度，两侧同步" title="拖动调整正文宽度，双击恢复默认"></div>
<div class="body-edge" data-edge="right" role="separator" aria-orientation="vertical" tabindex="0" aria-label="调整正文宽度，两侧同步" title="拖动调整正文宽度，双击恢复默认"></div>

<script>
  type Side = 'left' | 'right';
  const root = document.documentElement;
  // Matches --frame in global.css: the default layout width that sidebars and content share.
  const frame = 272 + 40 + 752 + 40 + 220;
  const minContent = 400;
  const wide = matchMedia('(min-width: 901px)');
  const wider = matchMedia('(min-width: 1181px)');
  const rails = [...document.querySelectorAll<HTMLElement>('[data-rail]')];
  const edges = [...document.querySelectorAll<HTMLElement>('.body-edge')];
  const key = (side: Side) => (side === 'left' ? 'railLeft' : 'railRight');
  const collapsed = (side: Side) => root.dataset[key(side)] === 'collapsed';
  let scale = Number.parseFloat(root.style.getPropertyValue('--body-scale')) || 1;

  const px = (name: string) => Number.parseFloat(getComputedStyle(root).getPropertyValue(name)) || 0;

  // Default content width for the current page, and the scale range that keeps the content between minContent and the viewport.
  const layout = () => {
    const gap = px('--col-gap');
    const sidebar = document.querySelector<HTMLElement>('.site-sidebar');
    const toc = document.querySelector<HTMLElement>('.reading-toc');
    const left = sidebar && wide.matches ? sidebar.getBoundingClientRect().width + gap : 0;
    const right = toc && wider.matches ? toc.getBoundingClientRect().width + gap : 0;
    const base = frame - left - right;
    const room = root.clientWidth - 2 * px('--page-x') - left - right;
    const lo = minContent / base;
    return { base, lo, hi: Math.max(lo, room / base) };
  };

  const sync = () => {
    const percent = String(Math.round(scale * 100));
    for (const handle of [...rails.map((rail) => rail.querySelector<HTMLElement>('.rail-handle')!), ...edges]) {
      handle.setAttribute('aria-valuenow', percent);
      handle.setAttribute('aria-valuetext', `正文宽度 ${percent}%`);
    }
    for (const rail of rails) {
      const toggle = rail.querySelector<HTMLButtonElement>('.rail-toggle')!;
      const open = !collapsed(rail.dataset.rail as Side);
      const text = `${open ? '收起' : '展开'}${toggle.dataset.label}`;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', text);
      toggle.title = text;
    }
  };

  const save = () => {
    try {
      localStorage.setItem('body-scale', String(scale));
      for (const side of ['left', 'right'] as Side[]) {
        if (collapsed(side)) localStorage.setItem(`rail-${side}`, 'collapsed');
        else localStorage.removeItem(`rail-${side}`);
      }
    } catch {}
  };

  const apply = (next: number) => {
    scale = Math.round(next * 10000) / 10000;
    root.style.setProperty('--body-scale', String(scale));
    sync();
  };

  // Content is centred, so moving one edge by dx changes the width by 2 * dx.
  const attach = (handle: HTMLElement, sign: number) => {
    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      event.preventDefault();
      const startX = event.clientX;
      const { base, lo, hi } = layout();
      const start = Math.min(scale, hi);
      handle.setPointerCapture(event.pointerId);
      root.dataset.resizing = '';
      const move = (next: PointerEvent) => apply(Math.min(hi, Math.max(lo, start + (sign * 2 * (next.clientX - startX)) / base)));
      const end = () => {
        handle.removeEventListener('pointermove', move);
        handle.removeEventListener('pointerup', end);
        handle.removeEventListener('pointercancel', end);
        delete root.dataset.resizing;
        save();
      };
      handle.addEventListener('pointermove', move);
      handle.addEventListener('pointerup', end);
      handle.addEventListener('pointercancel', end);
    });
    handle.addEventListener('dblclick', () => { apply(1); save(); });
    handle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const { base, lo, hi } = layout();
      const step = ((event.key === 'ArrowRight' ? 32 : -32) * sign) / base;
      apply(Math.min(hi, Math.max(lo, Math.min(scale, hi) + step)));
      save();
    });
  };

  for (const rail of rails) {
    const side = rail.dataset.rail as Side;
    attach(rail.querySelector<HTMLElement>('.rail-handle')!, side === 'left' ? -1 : 1);
    rail.querySelector<HTMLButtonElement>('.rail-toggle')!.addEventListener('click', () => {
      if (collapsed(side)) delete root.dataset[key(side)];
      else root.dataset[key(side)] = 'collapsed';
      sync();
      save();
    });
  }
  for (const edge of edges) attach(edge, edge.dataset.edge === 'left' ? -1 : 1);
  sync();
</script>

<style>
  .body-edge { position: absolute; top: 0; bottom: 0; z-index: 4; display: none; width: 12px; cursor: col-resize; touch-action: none; }
  [data-edge="left"] { left: -6px; }
  [data-edge="right"] { right: -6px; }
  .body-edge::after { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; transform: translateX(-50%); border-radius: 1px; background: transparent; transition: background .15s; }
  .body-edge:hover::after,
  .body-edge:focus-visible::after,
  :global(:root[data-resizing]) .body-edge::after { background: var(--accent); }
  .body-edge:focus-visible { outline: none; }

  @media (min-width: 901px) {
    :global(.site-body:not(:has(.site-sidebar))) [data-edge="left"],
    :global(:root[data-rail-left="collapsed"]) [data-edge="left"],
    :global(.site-main:not(:has(.reading-toc))) [data-edge="right"],
    :global(:root[data-rail-right="collapsed"]) [data-edge="right"] { display: block; }
  }
  @media (min-width: 901px) and (max-width: 1180px) {
    [data-edge="right"] { display: block; }
  }

  :global(:root[data-resizing]),
  :global(:root[data-resizing] *) { cursor: col-resize !important; user-select: none; }
  :global(:root[data-resizing] iframe) { pointer-events: none; }
</style>
