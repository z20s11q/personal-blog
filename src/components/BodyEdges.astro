<div class="body-edge" data-edge="left" role="separator" aria-orientation="vertical" tabindex="0" aria-label="调整正文左右边距，两侧同步" title="拖动调整正文宽度，双击恢复默认"></div>
<div class="body-edge" data-edge="right" role="separator" aria-orientation="vertical" tabindex="0" aria-label="调整正文左右边距，两侧同步" title="拖动调整正文宽度，双击恢复默认"></div>

<script>
  type Kind = 'rail' | 'body';
  type Side = 'left' | 'right';
  const root = document.documentElement;
  const limits: Record<Kind, [number, number]> = { rail: [-60, 240], body: [0, 600] };
  const prop: Record<Kind, string> = { rail: '--rail-delta', body: '--body-inset' };
  const railBase: Record<Side, number> = { left: 272, right: 220 };
  const minContent = 420;
  const value: Record<Kind, number> = {
    rail: Number.parseFloat(root.style.getPropertyValue(prop.rail)) || 0,
    body: Number.parseFloat(root.style.getPropertyValue(prop.body)) || 0,
  };
  const rails = [...document.querySelectorAll<HTMLElement>('[data-rail]')];
  const edges = [...document.querySelectorAll<HTMLElement>('.body-edge')];
  const key = (side: Side) => (side === 'left' ? 'railLeft' : 'railRight');
  const collapsed = (side: Side) => root.dataset[key(side)] === 'collapsed';
  const shown = (element: HTMLElement) => element.offsetParent !== null;

  const sync = () => {
    for (const rail of rails) {
      const side = rail.dataset.rail as Side;
      const handle = rail.querySelector<HTMLElement>('.rail-handle')!;
      const toggle = rail.querySelector<HTMLButtonElement>('.rail-toggle')!;
      handle.setAttribute('aria-valuenow', String(railBase[side] + value.rail));
      handle.setAttribute('aria-valuemin', String(railBase[side] + limits.rail[0]));
      handle.setAttribute('aria-valuemax', String(railBase[side] + limits.rail[1]));
      const open = !collapsed(side);
      const text = `${open ? '收起' : '展开'}${toggle.dataset.label}`;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', text);
      toggle.title = text;
    }
    for (const edge of edges) {
      edge.setAttribute('aria-valuenow', String(value.body));
      edge.setAttribute('aria-valuemin', String(limits.body[0]));
      edge.setAttribute('aria-valuemax', String(limits.body[1]));
    }
  };

  const save = () => {
    try {
      localStorage.setItem('rail-delta', String(value.rail));
      localStorage.setItem('body-inset', String(value.body));
      for (const side of ['left', 'right'] as Side[]) {
        if (collapsed(side)) localStorage.setItem(`rail-${side}`, 'collapsed');
        else localStorage.removeItem(`rail-${side}`);
      }
    } catch {}
  };

  const apply = (kind: Kind, next: number) => {
    value[kind] = Math.round(next);
    root.style.setProperty(prop[kind], `${value[kind]}px`);
    sync();
  };

  // Every open sidebar edge or bare body edge moves by the same amount, so the content loses that amount once per moving edge.
  const range = (kind: Kind) => {
    const [lo, top] = limits[kind];
    const main = document.querySelector<HTMLElement>('.site-main');
    const moving = kind === 'rail'
      ? rails.filter((rail) => shown(rail) && !collapsed(rail.dataset.rail as Side)).length
      : edges.filter(shown).length;
    if (!main || moving === 0) return { lo, hi: top };
    const gap = Number.parseFloat(getComputedStyle(root).getPropertyValue('--col-gap')) || 40;
    const box = main.getBoundingClientRect();
    const toc = rails.find((rail) => rail.dataset.rail === 'right' && shown(rail))?.parentElement;
    const content = (toc ? toc.getBoundingClientRect().left - gap : box.right) - box.left;
    const hi = Math.min(top, value[kind] + Math.max(0, content - minContent) / moving);
    return { lo, hi: Math.max(lo, hi) };
  };

  const attach = (handle: HTMLElement, kind: Kind, sign: number) => {
    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      event.preventDefault();
      const startX = event.clientX;
      const start = value[kind];
      const { lo, hi } = range(kind);
      handle.setPointerCapture(event.pointerId);
      root.dataset.resizing = kind;
      const move = (next: PointerEvent) => apply(kind, Math.min(hi, Math.max(lo, start + sign * (next.clientX - startX))));
      const end = () => {
        handle.removeEventListener('pointermove', move);
        handle.removeEventListener('pointerup', end);
        handle.removeEventListener('pointercancel', end);
        delete root.dataset.resizing;
        save();
      };
      handle.addEventListener('pointermove', move);
      handle.addEventListener('pointerup', end);
      handle.addEventListener('pointercancel', end);
    });
    handle.addEventListener('dblclick', () => { apply(kind, 0); save(); });
    handle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const { lo, hi } = range(kind);
      const step = (event.key === 'ArrowRight' ? 16 : -16) * sign;
      apply(kind, Math.min(Math.max(hi, value[kind]), Math.max(lo, value[kind] + step)));
      save();
    });
  };

  for (const rail of rails) {
    const side = rail.dataset.rail as Side;
    attach(rail.querySelector<HTMLElement>('.rail-handle')!, 'rail', side === 'left' ? 1 : -1);
    rail.querySelector<HTMLButtonElement>('.rail-toggle')!.addEventListener('click', () => {
      if (collapsed(side)) delete root.dataset[key(side)];
      else root.dataset[key(side)] = 'collapsed';
      sync();
      save();
    });
  }
  for (const edge of edges) attach(edge, 'body', edge.dataset.edge === 'left' ? 1 : -1);
  sync();
</script>

<style>
  .body-edge { position: absolute; top: 0; bottom: 0; z-index: 4; display: none; width: 12px; cursor: col-resize; touch-action: none; }
  [data-edge="left"] { left: -6px; }
  [data-edge="right"] { right: -6px; }
  .body-edge::after { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; transform: translateX(-50%); border-radius: 1px; background: transparent; transition: background .15s; }
  .body-edge:hover::after,
  .body-edge:focus-visible::after,
  :global(:root[data-resizing="body"]) .body-edge::after { background: var(--accent); }
  .body-edge:focus-visible { outline: none; }

  @media (min-width: 901px) {
    :global(.site-body:not(:has(.site-sidebar))) [data-edge="left"],
    :global(:root[data-rail-left="collapsed"]) [data-edge="left"],
    :global(.site-main:not(:has(.reading-toc))) [data-edge="right"],
    :global(:root[data-rail-right="collapsed"]) [data-edge="right"] { display: block; }
  }
  @media (min-width: 901px) and (max-width: 1180px) {
    [data-edge="right"] { display: block; }
  }

  :global(:root[data-resizing]),
  :global(:root[data-resizing] *) { cursor: col-resize !important; user-select: none; }
  :global(:root[data-resizing] iframe) { pointer-events: none; }
</style>
