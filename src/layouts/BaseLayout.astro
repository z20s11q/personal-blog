---
import '../styles/global.css';
import '../styles/prose.css';
import SiteSidebar from '../components/SiteSidebar.astro';
import { domains } from '../data/domains';
import { currentDomainSlug, getEntries } from '../data/entries';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  progress?: boolean;
}
const { title, description, canonical, progress = false } = Astro.props;
const siteName = 'z20s11q 的个人博客';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const searchUrl = `${base}search/`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const entries = await getEntries(base);
const domain = currentDomainSlug(path, entries, base);
const home = path === base || path === `${base}articles/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#1b1b1f' : '#ffffff';
        const min = 12, max = 24;
        let size = 16;
        try {
          const raw = localStorage.getItem('text-size');
          const stored = Number(raw);
          if (raw && Number.isInteger(stored)) size = Math.min(max, Math.max(min, stored));
        } catch {}
        document.documentElement.dataset.textSize = String(size);
        document.documentElement.style.setProperty('--prose-size', size + 'px');
      })();
    </script>
  </head>
  <body>
    {progress && <div class="reading-progress" aria-hidden="true"><span></span></div>}
    <div class="site-shell">
      <header class="site-header">
        <div class="frame header-bar">
        <div class="header-start">
          <a class="nav-link" href={base} aria-current={home ? 'page' : undefined}>首页</a>
          <a class="wordmark" href={base} aria-label="个人博客首页">z20s11q<span class="wordmark-sep"> / </span>notes</a>
          <a class="search-pill" href={searchUrl} aria-label="搜索">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span>搜索</span>
            <kbd>/</kbd>
          </a>
        </div>
        <div class="header-actions">
          <nav class="domain-nav" aria-label="领域">
            {domains.map((item) => <a class:list={[{ 'is-current': domain === item.slug }]} href={`${base}tags/${item.slug}/`} aria-current={path === `${base}tags/${item.slug}/` ? 'page' : undefined}>{item.label}</a>)}
          </nav>
          <div class="text-size" role="group" aria-label="正文字号，每次调整 1 像素">
            <button type="button" data-text-delta="-1" aria-label="减小正文字号">−</button>
            <span data-text-size-value>16</span>
            <button type="button" data-text-delta="1" aria-label="增大正文字号">+</button>
          </div>
          <button class="icon-button theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </div>
        </div>
      </header>
      <div class="frame site-body">
        <SiteSidebar entries={entries} domain={domain} />
        <div class="site-main">
          <main><slot /></main>
        </div>
        <footer class="site-footer">
            <div>
              <strong>z20s11q / notes</strong>
              <p>记录交易研究、编程学习、AI Agent 架构与以后值得整理的主题。</p>
            </div>
            <div class="footer-links">
              <a href={base}>首页</a>
              <a href={searchUrl}>搜索</a>
              <a href="https://github.com/z20s11q/personal-blog" target="_blank" rel="noopener noreferrer">网站源码 ↗</a>
            </div>
            <small>交易相关内容仅供学习研究，不构成投资建议。</small>
          </footer>
      </div>
    </div>
  </body>
</html>

<script>
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const apply = (theme: string) => {
    root.dataset.theme = theme;
    if (meta) meta.content = theme === 'dark' ? '#1b1b1f' : '#ffffff';
  };

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    apply(next);
    try { localStorage.setItem('theme', next); } catch {}
  });

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let stored: string | null = null;
    try { stored = localStorage.getItem('theme'); } catch {}
    if (!stored) apply(event.matches ? 'dark' : 'light');
  });

  const textMin = 12;
  const textMax = 24;
  const textValue = document.querySelector<HTMLElement>('[data-text-size-value]');
  const textButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-text-delta]')];
  const applyTextSize = (size: number) => {
    const next = Math.min(textMax, Math.max(textMin, size));
    root.dataset.textSize = String(next);
    root.style.setProperty('--prose-size', `${next}px`);
    if (textValue) {
      textValue.textContent = String(next);
      textValue.setAttribute('aria-label', `当前 ${next} 像素`);
    }
    for (const button of textButtons) {
      const delta = Number(button.dataset.textDelta);
      button.disabled = (delta < 0 && next <= textMin) || (delta > 0 && next >= textMax);
    }
    try { localStorage.setItem('text-size', String(next)); } catch {}
  };
  applyTextSize(Number(root.dataset.textSize) || 16);
  for (const button of textButtons) {
    button.addEventListener('click', () => applyTextSize((Number(root.dataset.textSize) || 16) + Number(button.dataset.textDelta)));
  }

  const search = document.querySelector<HTMLAnchorElement>('.search-pill');
  addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey || !search) return;
    const field = event.target instanceof HTMLElement ? event.target.closest('input, textarea, [contenteditable="true"]') : null;
    if (field) return;
    event.preventDefault();
    location.href = search.href;
  });

  const bar = document.querySelector<HTMLElement>('.reading-progress span');
  if (bar) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = root.scrollHeight - root.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, root.scrollTop / max) : 0})`;
    };
    addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener('resize', update);
    update();
  }

  const diagrams = [...document.querySelectorAll<HTMLElement>('.prose pre.mermaid')];
  if (diagrams.length) {
    const sources = diagrams.map((block) => block.textContent ?? '');
    for (const block of diagrams) {
      const frame = document.createElement('div');
      frame.className = 'diagram-frame';
      const zoom = document.createElement('button');
      zoom.type = 'button';
      zoom.className = 'diagram-zoom';
      zoom.textContent = '放大';
      zoom.setAttribute('aria-label', '放大查看图表');
      block.replaceWith(frame);
      frame.append(block, zoom);
    }

    const dialog = document.createElement('dialog');
    dialog.className = 'diagram-viewer';
    dialog.innerHTML = `<div class="diagram-toolbar"><button type="button" data-zoom="out" aria-label="缩小">−</button><span data-zoom-level>100%</span><button type="button" data-zoom="in" aria-label="放大">+</button><button type="button" data-zoom="fit">适应窗口</button><button type="button" data-zoom="close">关闭</button></div><div class="diagram-stage"><div class="diagram-canvas"></div></div>`;
    document.body.append(dialog);
    const stage = dialog.querySelector<HTMLElement>('.diagram-stage')!;
    const canvas = dialog.querySelector<HTMLElement>('.diagram-canvas')!;
    const level = dialog.querySelector<HTMLElement>('[data-zoom-level]')!;
    let scale = 1;
    let originX = 0;
    let originY = 0;
    const paint = () => {
      canvas.style.transform = `translate(${originX}px, ${originY}px) scale(${scale})`;
      level.textContent = `${Math.round(scale * 100)}%`;
    };
    const fit = () => {
      const svg = canvas.querySelector('svg');
      if (!svg) return;
      const box = svg.viewBox.baseVal;
      const width = box?.width || svg.getBoundingClientRect().width;
      const height = box?.height || svg.getBoundingClientRect().height;
      if (!width || !height) return;
      const next = Math.min((stage.clientWidth - 48) / width, (stage.clientHeight - 48) / height);
      scale = Math.min(8, Math.max(0.2, next));
      originX = (stage.clientWidth - width * scale) / 2;
      originY = (stage.clientHeight - height * scale) / 2;
      paint();
    };
    const zoomAt = (next: number, px: number, py: number) => {
      const clamped = Math.min(8, Math.max(0.2, next));
      const ratio = clamped / scale;
      originX = px - (px - originX) * ratio;
      originY = py - (py - originY) * ratio;
      scale = clamped;
      paint();
    };
    const open = (svg: SVGSVGElement) => {
      const clone = svg.cloneNode(true) as SVGSVGElement;
      const box = clone.viewBox.baseVal;
      if (box?.width) clone.style.width = `${box.width}px`;
      clone.style.maxWidth = 'none';
      canvas.replaceChildren(clone);
      dialog.showModal();
      requestAnimationFrame(fit);
    };

    document.addEventListener('click', (event) => {
      const frame = (event.target as HTMLElement | null)?.closest?.('.diagram-frame');
      if (!frame || (event.target as HTMLElement).closest('a')) return;
      const svg = frame.querySelector('svg');
      if (svg) open(svg);
    });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => canvas.replaceChildren());
    dialog.querySelector('[data-zoom="close"]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-zoom="fit"]')?.addEventListener('click', fit);
    dialog.querySelector('[data-zoom="in"]')?.addEventListener('click', () => zoomAt(scale * 1.25, stage.clientWidth / 2, stage.clientHeight / 2));
    dialog.querySelector('[data-zoom="out"]')?.addEventListener('click', () => zoomAt(scale / 1.25, stage.clientWidth / 2, stage.clientHeight / 2));
    stage.addEventListener('wheel', (event) => {
      event.preventDefault();
      const rect = stage.getBoundingClientRect();
      zoomAt(scale * (event.deltaY < 0 ? 1.12 : 1 / 1.12), event.clientX - rect.left, event.clientY - rect.top);
    }, { passive: false });
    let pan: { id: number; x: number; y: number } | null = null;
    stage.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      pan = { id: event.pointerId, x: event.clientX - originX, y: event.clientY - originY };
      stage.classList.add('is-panning');
      stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointermove', (event) => {
      if (!pan || pan.id !== event.pointerId) return;
      originX = event.clientX - pan.x;
      originY = event.clientY - pan.y;
      paint();
    });
    const endPan = (event: PointerEvent) => {
      if (!pan || pan.id !== event.pointerId) return;
      pan = null;
      stage.classList.remove('is-panning');
    };
    stage.addEventListener('pointerup', endPan);
    stage.addEventListener('pointercancel', endPan);

    const { default: mermaid } = await import('mermaid');
    const renderDiagrams = async () => {
      if (dialog.open) dialog.close();
      const dark = document.documentElement.dataset.theme === 'dark';
      mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: dark ? 'dark' : 'neutral' });
      diagrams.forEach((block, index) => {
        block.removeAttribute('data-processed');
        block.textContent = sources[index];
      });
      await mermaid.run({ nodes: diagrams, suppressErrors: true });
    };
    await renderDiagrams();
    new MutationObserver(renderDiagrams).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style is:global>
  .reading-progress { position: fixed; inset: 0 0 auto; z-index: 50; height: 3px; pointer-events: none; }
  .reading-progress span { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; }
</style>
