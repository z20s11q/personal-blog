---
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  progress?: boolean;
}
const { title, description, canonical, progress = false } = Astro.props;
const siteName = 'z20s11q 的个人博客';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const nav = [
  { href: base, label: '首页', match: (p: string) => p === base },
  { href: `${base}articles/`, label: '文章', match: (p: string) => p.startsWith(`${base}articles/`) },
  { href: `${base}rust/`, label: 'Rust 笔记', match: (p: string) => p.startsWith(`${base}rust/`) },
];
const searchUrl = `${base}search/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbf9" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#141917' : '#fbfbf9';
      })();
    </script>
  </head>
  <body>
    {progress && <div class="reading-progress" aria-hidden="true"><span></span></div>}
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={base} aria-label="个人博客首页">z20s11q<span class="wordmark-sep">/</span>notes</a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="icon-button" href={searchUrl} aria-label="搜索" title="搜索">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </a>
          <button class="icon-button theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <div>
          <strong>z20s11q / notes</strong>
          <p>记录交易研究、编程学习与以后值得整理的主题。</p>
        </div>
        <div class="footer-links">
          <a href={`${base}articles/`}>文章</a>
          <a href={`${base}rust/`}>Rust 笔记</a>
          <a href={searchUrl}>搜索</a>
          <a href="https://github.com/z20s11q/personal-blog" target="_blank" rel="noopener noreferrer">网站源码 ↗</a>
        </div>
        <small>交易相关内容仅供学习研究，不构成投资建议。</small>
      </footer>
    </div>
  </body>
</html>

<script>
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const apply = (theme: string) => {
    root.dataset.theme = theme;
    if (meta) meta.content = theme === 'dark' ? '#141917' : '#fbfbf9';
  };

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    apply(next);
    try { localStorage.setItem('theme', next); } catch {}
  });

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let stored: string | null = null;
    try { stored = localStorage.getItem('theme'); } catch {}
    if (!stored) apply(event.matches ? 'dark' : 'light');
  });

  const bar = document.querySelector<HTMLElement>('.reading-progress span');
  if (bar) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = root.scrollHeight - root.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, root.scrollTop / max) : 0})`;
    };
    addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style is:global>
  .reading-progress { position: fixed; inset: 0 0 auto; z-index: 50; height: 3px; pointer-events: none; }
  .reading-progress span { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; }
</style>
