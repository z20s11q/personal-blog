---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const pageTitle = title === '价格行为研究笔记' ? title : `${title} · 价格行为研究笔记`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const reportUrl = `${base}articles/price-action-field-guide/`;
const resourcesUrl = `${base}resources/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={base} aria-label="价格行为研究笔记首页">
          <span class="wordmark-icon" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>stock<span class="wordmark-sep">/</span>learn</span>
        </a>
        <nav aria-label="主导航">
          <a href={base}>首页</a>
          <a href={reportUrl}>研究报告</a>
          <a href={resourcesUrl}>资料索引</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <div>
          <strong>stock / learn</strong>
          <p>从原始资料出发，记录可以复核的交易研究。</p>
        </div>
        <div class="footer-links">
          <a href={reportUrl}>阅读报告</a>
          <a href={resourcesUrl}>查看来源</a>
          <a href="https://github.com/z20s11q/stock-learn" target="_blank" rel="noopener noreferrer">研究仓库 ↗</a>
        </div>
        <small>资料研究，不构成投资建议。更新于 2026 年 9 月。</small>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --bg:#fafaf8; --surface:#fff; --ink:#202525; --muted:#66706d; --line:#e2e6e1; --accent:#556a60; --accent-light:#f0f3ef; --green:#344c42; --soft:#f3f5f1; }
  @media (prefers-color-scheme: dark) { :root { --bg:#181d1b; --surface:#202724; --ink:#e9eeea; --muted:#a6b1aa; --line:#36413a; --accent:#abc5b4; --accent-light:#27352d; --green:#abc5b4; --soft:#202923; } }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--bg); color:var(--ink); font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans SC","Microsoft YaHei",sans-serif; line-height:1.7; -webkit-font-smoothing:antialiased; }
  a { color:inherit; text-decoration:none; }
  a:focus-visible { outline:2px solid var(--accent); outline-offset:4px; border-radius:2px; }
  .site-shell { max-width:1130px; margin:auto; }
  .site-header { height:64px; margin:0 30px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); gap:2rem; }
  .wordmark { display:inline-flex; align-items:center; gap:9px; font-size:16px; font-weight:800; letter-spacing:-.04em; white-space:nowrap; }
  .wordmark-sep { color:var(--accent); padding:0 2px; }
  .wordmark-icon { display:flex; align-items:flex-end; gap:3px; height:23px; width:28px; }
  .wordmark-icon i { display:block; width:5px; border:1.7px solid var(--accent); border-radius:1px; position:relative; }
  .wordmark-icon i:before,.wordmark-icon i:after { content:""; position:absolute; left:1px; width:1px; height:5px; background:var(--accent); }
  .wordmark-icon i:before { top:-6px; }.wordmark-icon i:after { bottom:-6px; }
  .wordmark-icon i:nth-child(1){height:9px}.wordmark-icon i:nth-child(2){height:17px}.wordmark-icon i:nth-child(3){height:12px}
  .site-header nav { display:flex; align-items:center; gap:clamp(1.1rem,3vw,2rem); font-size:12px; color:var(--muted); font-weight:650; }
  .site-header nav a:hover,.footer-links a:hover { color:var(--accent); }
  .site-footer { margin:50px 30px 0; padding:25px 0 24px; border-top:1px solid var(--line); display:grid; grid-template-columns:1fr auto; gap:12px; }
  .site-footer strong { letter-spacing:-.04em; font-size:18px; }.site-footer p { color:var(--muted); margin:3px 0; font-size:13px; }
  .footer-links { display:flex; gap:23px; color:var(--muted); font-size:12px; font-weight:650; align-items:start; padding-top:5px; }
  .site-footer small { grid-column:1/-1; color:var(--muted); font-size:11px; }
  .eyebrow { display:flex; align-items:center; gap:8px; color:var(--muted); font-size:10px; font-weight:750; letter-spacing:.1em; text-transform:uppercase; }
  .eyebrow:before { content:""; width:20px; height:1px; background:currentColor; }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:12px; min-height:38px; border-radius:3px; padding:0 14px; font-weight:700; font-size:12px; background:var(--ink); color:var(--surface); transition:opacity .15s; }
  @media (prefers-color-scheme: dark) { .button { color:#13201a; } }
  .button:hover { opacity:.8; }
  .text-link { color:var(--green); font-size:12px; font-weight:750; border-bottom:1px solid currentColor; padding-bottom:2px; }
  .text-link:hover { color:var(--accent); }
  @media(max-width:700px) { .site-header{height:58px;margin:0 18px;gap:1rem}.site-header nav{gap:12px;font-size:11px}.site-header nav a:nth-child(3){display:none}.wordmark{font-size:15px}.site-footer{margin:42px 18px 0;display:block}.footer-links{margin:14px 0;flex-wrap:wrap;gap:16px} }
</style>
