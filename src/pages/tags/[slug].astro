---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryIndex from '../../components/EntryIndex.astro';
import { domainCounts, getEntries } from '../../data/entries';

export async function getStaticPaths() {
  const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
  const entries = await getEntries(base);
  return domainCounts(entries).map((domain) => ({ params: { slug: domain.slug }, props: { domain, entries } }));
}

const { domain, entries } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(`${base}tags/${domain.slug}/`, Astro.site).href;
---

<BaseLayout title={`${domain.label} · 分类`} description={domain.description} canonical={canonical}>
  <header class="page-head intro">
    <div class="eyebrow">分类</div>
    <h1>{domain.label}</h1>
    <p>{domain.description}共 {domain.count} 篇。</p>
  </header>
  <EntryIndex all={entries} active={domain.slug} />
</BaseLayout>

<style>
  .intro { padding-bottom: 12px; }
</style>
