---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const rustSections = await getCollection('rust');
const rustChapters = new Set(rustSections.map((section) => section.data.chapter).filter((chapter) => chapter !== null)).size;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replaceAll('/', '.');
---

<BaseLayout title="z20s11q 的个人博客" description="交易研究、Rust 编程与持续学习的个人笔记。">
  <section class="page-head intro">
    <div class="eyebrow">z20s11q / notes</div>
    <h1>个人笔记</h1>
    <p>整理我正在学习和研究的内容。目前有价格行为研究与 Rust 学习资料，以后也会加入其他主题。</p>
  </section>

  <div class="home-grid">
    <div class="main-column">
      <section class="home-section">
        <div class="section-title"><h2>最新文章</h2><a href={`${base}articles/`}>全部文章 →</a></div>
        {articles.slice(0, 5).map((article) => (
          <a class="entry" href={`${base}articles/${article.id}/`}>
            <div class="entry-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time></div>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <small>约 {article.data.readingMinutes} 分钟阅读</small>
          </a>
        ))}
      </section>

      <section class="home-section">
        <div class="section-title"><h2>学习笔记</h2><span>连续阅读</span></div>
        <a class="entry" href={`${base}rust/`}>
          <div class="entry-meta"><span>编程 · Rust</span><span>{rustChapters} 章 · {rustSections.length} 节</span></div>
          <h3>Rust 编程语言（精简版）</h3>
          <p>基于 The Rust Programming Language 整理的中文学习笔记，全部章节在一页连续展开，目录会跟随阅读位置。</p>
        </a>
      </section>

      <section class="home-section">
        <div class="section-title"><h2>资料</h2><span>持续核对</span></div>
        <a class="entry" href={`${base}resources/`}>
          <div class="entry-meta"><span>交易研究</span><span>原始来源优先</span></div>
          <h3>价格行为资料索引</h3>
          <p>原始教材、中文讲解、案例复盘与市场机制资料，按可核验程度分别标注。</p>
        </a>
      </section>
    </div>

    <aside class="sidebar">
      <div class="aside-block">
        <h2>关于本站</h2>
        <p>交易内容区分理论、教学质量和可验证的实战结果，优先核查原始资料与完整案例。编程笔记侧重查阅和实践。</p>
        <p>有值得长期保存的学习记录，会再逐步加入新的主题。</p>
      </div>
      <div class="aside-block">
        <h2>快速查找</h2>
        <p>全站文章和 Rust 笔记都可以通过<a class="inline-link" href={`${base}search/`}>站内搜索</a>按关键词定位。</p>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .intro { padding-bottom: 40px; }
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 56px;
    margin: 0 var(--page-x);
  }
  .main-column { min-width: 0; }
  .home-section { padding-top: 40px; }

  .entry {
    display: block;
    padding: 24px 0 26px;
    border-bottom: 1px solid var(--line);
  }
  .entry:last-child { border-bottom: 0; }
  .entry-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; color: var(--muted); font-size: 14px; }
  .entry-meta > * + *::before { content: "·"; margin-right: 12px; color: var(--line); }
  .entry h3 {
    margin: 8px 0 8px;
    font-size: 23px;
    line-height: 1.4;
    letter-spacing: -.025em;
    transition: color .15s;
  }
  .entry:hover h3 { color: var(--accent); }
  .entry p { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.75; }
  .entry small { display: block; margin-top: 10px; color: var(--muted); font-size: 14px; }

  .sidebar { padding-top: 40px; }
  .aside-block { padding: 20px 22px; margin-bottom: 20px; border-radius: 8px; background: var(--soft); }
  .aside-block h2 { margin: 0 0 8px; font-size: 16px; letter-spacing: -.01em; }
  .aside-block p { margin: 0 0 8px; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .aside-block p:last-child { margin-bottom: 0; }
  .inline-link { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 860px) {
    .home-grid { grid-template-columns: 1fr; gap: 0; }
    .sidebar { padding-top: 24px; }
  }
  @media (max-width: 760px) {
    .home-section { padding-top: 32px; }
    .entry h3 { font-size: 20px; }
    .entry p { font-size: 15px; }
  }
</style>
