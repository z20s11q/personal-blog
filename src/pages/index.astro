---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryIndex from '../components/EntryIndex.astro';
import { getEntries } from '../data/entries';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const entries = await getEntries(base);
---

<BaseLayout title="z20s11q 的个人博客" description="交易研究、编程学习与 AI Agent 架构解析的个人笔记。">
  <section class="page-head intro">
    <div class="eyebrow">z20s11q / notes</div>
    <h1>个人笔记</h1>
    <p>整理我正在学习和研究的内容：价格行为研究、Rust 学习笔记和 AI Agent 架构解析。右上角按领域进入，左侧只列出当前领域的文章。</p>
  </section>
  <EntryIndex entries={entries} />
</BaseLayout>

<style>
  .intro { padding-bottom: 12px; }
</style>
