---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import ReadingToc from '../../components/ReadingToc.astro';
import type { TocItem } from '../../components/ReadingToc.astro';

const sections = (await getCollection('rust')).sort((a, b) => a.data.order.localeCompare(b.data.order));
const rendered = await Promise.all(sections.map(async (section) => ({ section, ...await render(section) })));
const chapters = [...new Set(sections.filter((section) => section.data.chapter !== null).map((section) => section.data.chapter!))]
  .map((number) => ({
    number,
    items: rendered.filter(({ section }) => section.data.chapter === number),
  }));
const appendices = rendered.filter(({ section }) => section.data.chapter === null);
const toc: TocItem[] = [];
for (const { number, items } of chapters) {
  toc.push({ id: `chapter-${number}`, text: number === 0 ? '引言' : `第 ${number} 章 ${items[0].section.data.title}`, depth: 2 });
  for (const { section, headings } of items) {
    if (section.id !== items[0].section.id) toc.push({ id: `section-${section.id}`, text: section.data.title, depth: 3 });
    for (const heading of headings.filter((item) => item.depth >= 2 && item.depth <= 4)) {
      toc.push({ id: `section-${section.id}--${heading.slug}`, text: heading.text, depth: Math.min(6, heading.depth + 2) });
    }
  }
}
toc.push({ id: 'appendices', text: '附录', depth: 2 });
for (const { section, headings } of appendices) {
  toc.push({ id: `section-${section.id}`, text: section.data.title, depth: 3 });
  for (const heading of headings.filter((item) => item.depth >= 2 && item.depth <= 4)) {
    toc.push({ id: `section-${section.id}--${heading.slug}`, text: heading.text, depth: Math.min(6, heading.depth + 2) });
  }
}
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const rustBase = `${base}rust/`;
const canonical = new URL(rustBase, Astro.site).href;
---

<BaseLayout title="Rust 编程语言（精简版）" description="在同一页面从上到下阅读 Rust 编程语言精简学习笔记。" canonical={canonical} progress>
  <header class="page-head" id="top">
    <div class="eyebrow">编程学习 / Rust</div>
    <h1>Rust 编程语言（精简版）</h1>
    <p>基于 The Rust Programming Language 整理的中文学习笔记。全部章节在这一页连续展开，可以直接向下阅读；目录会跟随当前阅读位置。</p>
    <div class="page-meta"><span>{chapters.length} 章</span><span>{sections.length} 节</span><span>含 {appendices.length} 篇附录</span></div>
    <div class="page-links"><a href="#chapter-0">开始阅读 ↓</a><a href="https://github.com/z20s11q/rust-book-web" target="_blank" rel="noopener noreferrer">原项目 ↗</a></div>
  </header>
  <div class="rust-layout">
    <ReadingToc items={toc} label="目录" namespaceSections />
    <div class="reading-column" data-pagefind-body>
      {chapters.map(({ number, items }) => <section class="chapter" id={`chapter-${number}`}>
        <div class="chapter-heading"><span>{String(number).padStart(2, '0')}</span><h2>{items[0].section.data.title}</h2></div>
        {items.map(({ section, Content }, index) => <section class="reading-section" id={`section-${section.id}`}>
          {index > 0 && <h3 class="section-heading">{section.data.title}</h3>}
          <div class="prose"><Content /></div>
        </section>)}
      </section>)}
      <section class="chapter" id="appendices">
        <div class="chapter-heading"><span>A</span><h2>附录</h2></div>
        {appendices.map(({ section, Content }, index) => <section class="reading-section" id={`section-${section.id}`}>
          {index > 0 && <h3 class="section-heading">{section.data.title}</h3>}
          <div class="prose"><Content /></div>
        </section>)}
      </section>
      <a class="back-top" href="#top" data-pagefind-ignore>↑ 返回顶部</a>
    </div>
  </div>
</BaseLayout>

<style>
  .rust-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: 56px;
    margin: 0 var(--page-x);
    padding: 40px 0;
  }

  .reading-column { min-width: 0; }
  .chapter { padding: 8px 0 32px; border-bottom: 1px solid var(--line); scroll-margin-top: 20px; }
  .chapter + .chapter { padding-top: 48px; }
  .chapter-heading { display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px; }
  .chapter-heading span {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    height: 28px;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    transform: translateY(-3px);
  }
  .chapter-heading h2 { margin: 0; font-size: 30px; line-height: 1.3; letter-spacing: -.03em; }
  .reading-section { scroll-margin-top: 20px; }
  .section-heading {
    margin: 44px 0 16px;
    padding-top: 28px;
    border-top: 1px dashed var(--line);
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -.02em;
  }
  .reading-column .prose :global(h2) { font-size: 21px; margin-top: 36px; }
  .reading-column .prose :global(h3) { font-size: 18px; }
  .reading-column .prose { font-size: 16.5px; }

  .back-top { display: inline-block; margin-top: 28px; color: var(--muted); font-size: 15px; font-weight: 700; }
  .back-top:hover { color: var(--ink); }

  @media (max-width: 900px) {
    .rust-layout { grid-template-columns: 1fr; gap: 0; padding-top: 0; }
    .chapter { scroll-margin-top: 64px; }
    .reading-section, .reading-column .prose :global(:is(h2, h3, h4)[id]) { scroll-margin-top: 64px; }
  }
  @media (max-width: 760px) {
    .chapter-heading h2 { font-size: 25px; }
    .section-heading { font-size: 21px; }
    .reading-column .prose { font-size: 16px; }
  }
</style>
