---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const sections = (await getCollection('rust')).sort((a, b) => a.data.order.localeCompare(b.data.order));
const chapters = [...new Set(sections.filter((s) => s.data.chapter !== null).map((s) => s.data.chapter!))]
  .map((number) => ({
    number,
    items: sections.filter((s) => s.data.chapter === number),
  }));
const appendices = sections.filter((s) => s.data.chapter === null);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const rustBase = `${base}rust/`;
const canonical = new URL(rustBase, Astro.site).href;
---

<BaseLayout title="Rust 编程语言（精简版）" description="按章节阅读 Rust 编程语言精简学习笔记。" canonical={canonical}>
  <header class="rust-header">
    <div class="eyebrow">编程学习 / Rust</div>
    <h1>Rust 编程语言（精简版）</h1>
    <p>基于 The Rust Programming Language 整理的中文学习笔记，保留原书章节顺序，按主题压缩叙述并加入语言对照。现在作为个人博客的 Rust 专题阅读。</p>
    <div class="header-links"><a href={`${rustBase}${sections[0].id}/`}>从引言开始 →</a><a href="https://github.com/z20s11q/rust-book-web" target="_blank" rel="noopener noreferrer">原项目 ↗</a></div>
  </header>
  <div class="rust-layout">
    <aside class="chapter-nav" aria-label="章节导航">
      <span>跳到章节</span>
      {chapters.map(({ number, items }) => <a href={`#chapter-${number}`}>{String(number).padStart(2, '0')} · {items[0].data.title}</a>)}
      <a href="#appendices">附录</a>
    </aside>
    <div class="chapters">
      <div class="list-heading"><h2>目录</h2><span>{chapters.length} 章 · {sections.length} 节</span></div>
      {chapters.map(({ number, items }) => <section class="chapter" id={`chapter-${number}`}>
        <div class="chapter-heading"><span>{String(number).padStart(2, '0')}</span><h2><a href={`${rustBase}${items[0].id}/`}>{items[0].data.title}</a></h2></div>
        {items.length > 1 && <div class="section-list">{items.slice(1).map((item) => <a href={`${rustBase}${item.id}/`}>{item.data.title}<span aria-hidden="true">↗</span></a>)}</div>}
      </section>)}
      <section class="chapter" id="appendices">
        <div class="chapter-heading"><span>A</span><h2>附录</h2></div>
        <div class="section-list">{appendices.map((item) => <a href={`${rustBase}${item.id}/`}>{item.data.title}<span aria-hidden="true">↗</span></a>)}</div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .rust-header{margin:0 30px;padding:45px 0 35px;border-bottom:1px solid var(--line)}
  .rust-header h1{font-size:clamp(30px,4vw,45px);line-height:1.25;letter-spacing:-.055em;margin:14px 0 8px}
  .rust-header p{font-size:14px;color:var(--muted);max-width:750px;margin:0}
  .header-links{display:flex;gap:24px;margin-top:20px;font-size:12px;font-weight:700}
  .header-links a{border-bottom:1px solid var(--line);padding-bottom:2px}.header-links a:hover{color:var(--accent)}
  .rust-layout{display:grid;grid-template-columns:190px minmax(0,1fr);gap:44px;margin:0 30px;padding:30px 0}
  .chapter-nav{position:sticky;top:20px;align-self:start;max-height:calc(100vh - 40px);overflow:auto;display:flex;flex-direction:column;gap:4px;padding-right:15px;border-right:1px solid var(--line)}
  .chapter-nav span{font-size:11px;font-weight:750;color:var(--muted);margin-bottom:8px}.chapter-nav a{font-size:11px;color:var(--muted);line-height:1.45;padding:3px 0}.chapter-nav a:hover{color:var(--ink)}
  .list-heading{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:10px}.list-heading h2{font-size:16px;margin:0}.list-heading span{font-size:11px;color:var(--muted)}
  .chapter{padding:18px 0 17px;border-bottom:1px solid var(--line);scroll-margin-top:20px}.chapter-heading{display:grid;grid-template-columns:33px 1fr;align-items:baseline;gap:9px}.chapter-heading span{font-size:11px;color:var(--muted);font-weight:750}.chapter-heading h2{font-size:17px;letter-spacing:-.025em;margin:0}.chapter-heading a:hover{color:var(--accent)}
  .section-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:30px;margin:8px 0 0 42px}.section-list a{display:flex;justify-content:space-between;gap:12px;padding:5px 0;color:var(--muted);font-size:12px;line-height:1.5}.section-list a:hover{color:var(--ink)}.section-list span{font-size:11px;color:var(--muted)}
  @media(max-width:800px){.rust-layout{grid-template-columns:1fr}.chapter-nav{position:static;max-height:none;display:block;border-right:0;border-bottom:1px solid var(--line);padding:0 0 16px}.chapter-nav a{display:inline-block;margin-right:13px}}
  @media(max-width:600px){.rust-header,.rust-layout{margin-left:18px;margin-right:18px}.rust-header{padding:35px 0 26px}.rust-header p{font-size:13px}.rust-layout{padding-top:20px;gap:20px}.section-list{grid-template-columns:1fr}.chapter-heading h2{font-size:16px}}
</style>
