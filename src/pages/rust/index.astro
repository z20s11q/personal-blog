---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const sections = (await getCollection('rust')).sort((a, b) => a.data.order.localeCompare(b.data.order));
const rendered = await Promise.all(sections.map(async (section) => ({ section, Content: (await render(section)).Content })));
const chapters = [...new Set(sections.filter((section) => section.data.chapter !== null).map((section) => section.data.chapter!))]
  .map((number) => ({
    number,
    items: rendered.filter(({ section }) => section.data.chapter === number),
  }));
const appendices = rendered.filter(({ section }) => section.data.chapter === null);
const navItems = [
  ...chapters.map(({ number, items }) => ({ id: `chapter-${number}`, label: `${String(number).padStart(2, '0')} · ${items[0].section.data.title}` })),
  { id: 'appendices', label: 'A · 附录' },
];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const rustBase = `${base}rust/`;
const canonical = new URL(rustBase, Astro.site).href;
---

<BaseLayout title="Rust 编程语言（精简版）" description="在同一页面从上到下阅读 Rust 编程语言精简学习笔记。" canonical={canonical} progress>
  <header class="page-head" id="top">
    <div class="eyebrow">编程学习 / Rust</div>
    <h1>Rust 编程语言（精简版）</h1>
    <p>基于 The Rust Programming Language 整理的中文学习笔记。全部章节在这一页连续展开，可以直接向下阅读；目录会跟随当前阅读位置。</p>
    <div class="page-meta"><span>{chapters.length} 章</span><span>{sections.length} 节</span><span>含 {appendices.length} 篇附录</span></div>
    <div class="page-links"><a href="#chapter-0">开始阅读 ↓</a><a href="https://github.com/z20s11q/rust-book-web" target="_blank" rel="noopener noreferrer">原项目 ↗</a></div>
  </header>
  <div class="rust-layout">
    <nav class="chapter-nav" aria-label="页内目录">
      <details class="chapter-details" open>
        <summary><span class="summary-label">目录</span><span class="summary-current" data-current>{navItems[0].label}</span></summary>
        <div class="chapter-links">
          {navItems.map((item) => <a href={`#${item.id}`} data-target={item.id}>{item.label}</a>)}
        </div>
      </details>
      <script is:inline>
        if (matchMedia('(max-width: 900px)').matches) document.currentScript.previousElementSibling.open = false;
      </script>
    </nav>
    <div class="reading-column" data-pagefind-body>
      {chapters.map(({ number, items }) => <section class="chapter" id={`chapter-${number}`}>
        <div class="chapter-heading"><span>{String(number).padStart(2, '0')}</span><h2>{items[0].section.data.title}</h2></div>
        {items.map(({ section, Content }, index) => <section class="reading-section" id={`section-${section.id}`}>
          {index > 0 && <h3 class="section-heading">{section.data.title}</h3>}
          <div class="prose"><Content /></div>
        </section>)}
      </section>)}
      <section class="chapter" id="appendices">
        <div class="chapter-heading"><span>A</span><h2>附录</h2></div>
        {appendices.map(({ section, Content }, index) => <section class="reading-section" id={`section-${section.id}`}>
          {index > 0 && <h3 class="section-heading">{section.data.title}</h3>}
          <div class="prose"><Content /></div>
        </section>)}
      </section>
      <a class="back-top" href="#top" data-pagefind-ignore>↑ 返回顶部</a>
    </div>
  </div>
</BaseLayout>

<script>
  const nav = document.querySelector<HTMLElement>('.chapter-nav')!;
  const details = nav.querySelector<HTMLDetailsElement>('details')!;
  const current = nav.querySelector<HTMLElement>('[data-current]')!;
  const linkList = nav.querySelector<HTMLElement>('.chapter-links')!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-target]')];
  const chapters = links
    .map((link) => document.getElementById(link.dataset.target!))
    .filter((el): el is HTMLElement => !!el);
  const mobile = matchMedia('(max-width: 900px)');

  let activeId = '';
  const setActive = () => {
    const chapter = chapters.filter((el) => el.getBoundingClientRect().top < innerHeight * 0.25).at(-1) ?? chapters[0];
    if (!chapter || chapter.id === activeId) return;
    activeId = chapter.id;
    for (const link of links) {
      const isActive = link.dataset.target === activeId;
      link.classList.toggle('active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'location');
        current.textContent = link.textContent;
        const top = link.offsetTop - linkList.clientHeight / 2;
        linkList.scrollTo({ top, behavior: 'smooth' });
      } else {
        link.removeAttribute('aria-current');
      }
    }
  };

  let queued = false;
  addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; setActive(); }); }
  }, { passive: true });
  setActive();

  linkList.addEventListener('click', (event) => {
    if (mobile.matches && (event.target as HTMLElement).closest('a')) details.open = false;
  });
  mobile.addEventListener('change', (event) => { details.open = !event.matches; });
</script>

<style>
  .rust-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: 56px;
    margin: 0 var(--page-x);
    padding: 40px 0;
  }

  .chapter-nav { position: sticky; top: 28px; align-self: start; }
  .chapter-details summary { list-style: none; }
  .chapter-details summary::-webkit-details-marker { display: none; }
  .summary-label { color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .06em; }
  .summary-current { display: none; }
  .chapter-links {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 90px);
    margin-top: 12px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .chapter-links a {
    padding: 6px 8px 6px 14px;
    border-left: 2px solid var(--line);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
    transition: color .15s, border-color .15s;
  }
  .chapter-links a:hover { color: var(--ink); }
  .chapter-links a.active { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }

  .reading-column { min-width: 0; }
  .chapter { padding: 8px 0 32px; border-bottom: 1px solid var(--line); scroll-margin-top: 20px; }
  .chapter + .chapter { padding-top: 48px; }
  .chapter-heading { display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px; }
  .chapter-heading span {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    height: 28px;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    transform: translateY(-3px);
  }
  .chapter-heading h2 { margin: 0; font-size: 30px; line-height: 1.3; letter-spacing: -.03em; }
  .reading-section { scroll-margin-top: 20px; }
  .section-heading {
    margin: 44px 0 16px;
    padding-top: 28px;
    border-top: 1px dashed var(--line);
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -.02em;
  }
  .reading-column .prose :global(h2) { font-size: 21px; margin-top: 36px; }
  .reading-column .prose :global(h3) { font-size: 18px; }
  .reading-column .prose { font-size: 16.5px; }

  .back-top { display: inline-block; margin-top: 28px; color: var(--muted); font-size: 15px; font-weight: 700; }
  .back-top:hover { color: var(--ink); }

  @media (max-width: 900px) {
    .rust-layout { grid-template-columns: 1fr; gap: 0; padding-top: 0; }
    .chapter-nav {
      top: 0;
      z-index: 20;
      margin: 0 calc(-1 * var(--page-x)) 24px;
      padding: 0 var(--page-x);
      border-bottom: 1px solid var(--line);
      background: var(--bg);
    }
    .chapter-details summary {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 50px;
      cursor: pointer;
    }
    .chapter-details summary::after {
      content: "";
      width: 8px;
      height: 8px;
      margin-left: auto;
      border-right: 2px solid var(--muted);
      border-bottom: 2px solid var(--muted);
      transform: translateY(-2px) rotate(45deg);
      transition: transform .15s;
    }
    .chapter-details[open] summary::after { transform: translateY(2px) rotate(-135deg); }
    .summary-current {
      display: block;
      overflow: hidden;
      color: var(--ink);
      font-size: 15px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .chapter-links { max-height: 60vh; margin: 0; padding-bottom: 12px; }
    .chapter-links a { font-size: 15px; padding: 9px 12px; }
    .chapter { scroll-margin-top: 64px; }
    .reading-section, .reading-column .prose :global(:is(h2, h3, h4)[id]) { scroll-margin-top: 64px; }
  }
  @media (max-width: 760px) {
    .chapter-heading h2 { font-size: 25px; }
    .section-heading { font-size: 21px; }
    .reading-column .prose { font-size: 16px; }
  }
</style>
