---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const sections = (await getCollection('rust')).sort((a, b) => a.data.order.localeCompare(b.data.order));
const rendered = await Promise.all(sections.map(async (section) => ({ section, Content: (await render(section)).Content })));
const chapters = [...new Set(sections.filter((section) => section.data.chapter !== null).map((section) => section.data.chapter!))]
  .map((number) => ({
    number,
    items: rendered.filter(({ section }) => section.data.chapter === number),
  }));
const appendices = rendered.filter(({ section }) => section.data.chapter === null);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const rustBase = `${base}rust/`;
const canonical = new URL(rustBase, Astro.site).href;
---

<BaseLayout title="Rust 编程语言（精简版）" description="在同一页面从上到下阅读 Rust 编程语言精简学习笔记。" canonical={canonical}>
  <header class="rust-header" id="top">
    <div class="eyebrow">编程学习 / Rust</div>
    <h1>Rust 编程语言（精简版）</h1>
    <p>基于 The Rust Programming Language 整理的中文学习笔记。全部章节在这一页连续展开，可以直接向下阅读；目录只用于在本页定位。</p>
    <div class="header-links"><a href="#chapter-0">开始阅读 ↓</a><a href="https://github.com/z20s11q/rust-book-web" target="_blank" rel="noopener noreferrer">原项目 ↗</a></div>
  </header>
  <div class="rust-layout">
    <aside class="chapter-nav" aria-label="页内目录">
      <span>页内目录</span>
      {chapters.map(({ number, items }) => <a href={`#chapter-${number}`}>{String(number).padStart(2, '0')} · {items[0].section.data.title}</a>)}
      <a href="#appendices">附录</a>
    </aside>
    <div class="reading-column">
      <div class="reading-heading"><span>连续阅读</span><span>{chapters.length} 章 · {sections.length} 节</span></div>
      {chapters.map(({ number, items }) => <section class="chapter" id={`chapter-${number}`}>
        <div class="chapter-heading"><span>{String(number).padStart(2, '0')}</span><h2>{items[0].section.data.title}</h2></div>
        {items.map(({ section, Content }, index) => <section class="reading-section" id={`section-${section.id}`}>
          {index > 0 && <h3>{section.data.title}</h3>}
          <div class="prose"><Content /></div>
        </section>)}
      </section>)}
      <section class="chapter" id="appendices">
        <div class="chapter-heading"><span>A</span><h2>附录</h2></div>
        {appendices.map(({ section, Content }, index) => <section class="reading-section" id={`section-${section.id}`}>
          {index > 0 && <h3>{section.data.title}</h3>}
          <div class="prose"><Content /></div>
        </section>)}
      </section>
      <a class="back-top" href="#top">↑ 返回顶部</a>
    </div>
  </div>
</BaseLayout>

<style>
  .rust-header{margin:0 30px;padding:45px 0 35px;border-bottom:1px solid var(--line)}
  .rust-header h1{font-size:clamp(30px,4vw,45px);line-height:1.25;letter-spacing:-.055em;margin:14px 0 8px}
  .rust-header p{font-size:14px;color:var(--muted);max-width:750px;margin:0}
  .header-links{display:flex;gap:24px;margin-top:20px;font-size:12px;font-weight:700}
  .header-links a{border-bottom:1px solid var(--line);padding-bottom:2px}.header-links a:hover{color:var(--accent)}
  .rust-layout{display:grid;grid-template-columns:190px minmax(0,790px);gap:44px;margin:0 30px;padding:30px 0}
  .chapter-nav{position:sticky;top:20px;align-self:start;max-height:calc(100vh - 40px);overflow:auto;display:flex;flex-direction:column;gap:4px;padding-right:15px;border-right:1px solid var(--line)}
  .chapter-nav span{font-size:11px;font-weight:750;color:var(--muted);margin-bottom:8px}.chapter-nav a{font-size:11px;color:var(--muted);line-height:1.45;padding:3px 0}.chapter-nav a:hover{color:var(--ink)}
  .reading-column{min-width:0}.reading-heading{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 0 11px;color:var(--muted);font-size:11px;font-weight:700}
  .chapter{padding:30px 0 12px;border-bottom:1px solid var(--line);scroll-margin-top:15px}.chapter-heading{display:grid;grid-template-columns:34px 1fr;align-items:baseline;gap:8px;margin-bottom:12px}.chapter-heading span{font-size:11px;color:var(--muted);font-weight:750}.chapter-heading h2{font-size:25px;letter-spacing:-.04em;line-height:1.35;margin:0}
  .reading-section{scroll-margin-top:15px}.reading-section>h3{font-size:19px;letter-spacing:-.03em;line-height:1.4;margin:29px 0 10px;padding-top:22px;border-top:1px solid var(--line)}
  .prose{min-width:0;font-size:14px;line-height:1.8;overflow-wrap:break-word}.prose :global(h2){font-size:18px;line-height:1.4;letter-spacing:-.025em;margin:25px 0 9px;scroll-margin-top:18px}.prose :global(h3){font-size:16px;line-height:1.4;margin:22px 0 8px;scroll-margin-top:18px}.prose :global(h4){font-size:14px;margin:18px 0 7px}.prose :global(p){margin:0 0 11px}.prose :global(ul),.prose :global(ol){margin:0 0 15px;padding-left:1.5em}.prose :global(li){margin:4px 0}.prose :global(a){color:var(--green);text-decoration:underline;text-underline-offset:3px}.prose :global(blockquote){border-left:2px solid var(--line);background:var(--soft);padding:11px 16px;margin:0 0 16px;font-size:12px}.prose :global(blockquote p:last-child){margin-bottom:0}.prose :global(:not(pre) > code){background:var(--soft);padding:1px 4px;font-size:.9em;overflow-wrap:anywhere}.prose :global(pre){font-size:12px;line-height:1.6;overflow-x:auto;padding:15px 18px;border:1px solid var(--line);border-radius:2px;margin:12px 0 18px}.prose :global(pre code){font-size:inherit}.prose :global(table){border-collapse:collapse;width:100%;font-size:12px;margin:14px 0;display:block;overflow-x:auto}.prose :global(th),.prose :global(td){border-bottom:1px solid var(--line);padding:7px 9px;text-align:left}.prose :global(th){background:var(--soft)}
  .back-top{display:inline-block;font-size:12px;font-weight:700;margin-top:24px;color:var(--muted)}.back-top:hover{color:var(--ink)}
  @media(max-width:850px){.rust-layout{grid-template-columns:1fr;gap:18px}.chapter-nav{position:static;max-height:none;display:block;border-right:0;border-bottom:1px solid var(--line);padding:0 0 15px}.chapter-nav a{display:inline-block;margin-right:12px}.reading-column{max-width:790px;width:100%;margin:auto}}
  @media(max-width:600px){.rust-header,.rust-layout{margin-left:18px;margin-right:18px}.rust-header{padding:35px 0 26px}.rust-header p{font-size:13px}.rust-layout{padding-top:20px}.chapter{padding-top:27px}.chapter-heading h2{font-size:22px}.reading-section>h3{font-size:17px}.prose{font-size:13px}.prose :global(h2){font-size:17px}}
</style>
