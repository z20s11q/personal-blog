---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const sections = (await getCollection('rust')).sort((a, b) => a.data.order.localeCompare(b.data.order));
  return sections.map((section, index) => ({
    params: { id: section.id },
    props: { section, previous: sections[index - 1] ?? null, next: sections[index + 1] ?? null },
  }));
}

const { section, previous, next } = Astro.props;
const { Content, headings } = await render(section);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const rustBase = `${base}rust/`;
const canonical = new URL(`${rustBase}${section.id}/`, Astro.site).href;
---

<BaseLayout title={section.data.title} description={`Rust 编程语言（精简版）：${section.data.title}`} canonical={canonical}>
  <header class="rust-header">
    <div class="eyebrow">编程学习 / Rust</div>
    <a class="index-link" href={rustBase}>← 返回 Rust 目录</a>
    <h1>{section.data.title}</h1>
    <p>Rust 编程语言（精简版）{section.data.chapter === null ? ' · 附录' : ` · 第 ${section.data.chapter} 章`}</p>
  </header>
  <div class="reading-grid">
    <aside class="toc" aria-label="本节目录">
      <div class="toc-inner">
        <span>本节目录</span>
        {toc.length ? toc.map((heading) => <a href={`#${heading.slug}`} class:list={{ sub: heading.depth === 3 }}>{heading.text}</a>) : <p>本节是章节导言。</p>}
        <a class="all-chapters" href={rustBase}>全部章节 →</a>
      </div>
    </aside>
    <article class="prose"><Content /></article>
  </div>
  <nav class="page-nav" aria-label="相邻章节">
    {previous ? <a href={`${rustBase}${previous.id}/`}><span>← 上一节</span><strong>{previous.data.title}</strong></a> : <div />}
    {next ? <a href={`${rustBase}${next.id}/`}><span>下一节 →</span><strong>{next.data.title}</strong></a> : <div />}
  </nav>
</BaseLayout>

<style>
  .rust-header{position:relative;margin:0 30px;padding:40px 0 27px;border-bottom:1px solid var(--line)}
  .index-link{display:inline-block;margin-top:15px;color:var(--muted);font-size:11px;font-weight:650}.index-link:hover{color:var(--ink)}
  .rust-header h1{font-size:clamp(30px,4vw,43px);line-height:1.3;letter-spacing:-.05em;margin:12px 0 5px}.rust-header p{font-size:12px;color:var(--muted);margin:0}
  .reading-grid{display:grid;grid-template-columns:190px minmax(0,790px);gap:44px;margin:0 30px;padding:30px 0}
  .toc-inner{position:sticky;top:20px;max-height:calc(100vh - 40px);overflow:auto;display:flex;flex-direction:column;align-items:stretch}
  .toc span{font-size:11px;font-weight:750;color:var(--muted);margin-bottom:10px}.toc a{font-size:11px;line-height:1.5;color:var(--muted);padding:5px 7px;border-left:1px solid var(--line)}.toc a.sub{padding-left:17px}.toc a:hover{color:var(--ink);border-left-color:var(--ink)}.toc p{font-size:11px;color:var(--muted)}.toc .all-chapters{border:0;margin-top:13px;padding-left:0;color:var(--ink);font-weight:700}
  .prose{min-width:0;font-size:14px;line-height:1.8}.prose :global(h2){font-size:23px;line-height:1.35;letter-spacing:-.035em;margin:32px 0 10px;scroll-margin-top:18px}.prose :global(h2:first-child){margin-top:0}.prose :global(h3){font-size:17px;line-height:1.4;letter-spacing:-.02em;margin:26px 0 8px;scroll-margin-top:18px}.prose :global(h4){font-size:14px;margin:22px 0 8px}.prose :global(p){margin:0 0 11px}.prose :global(ul),.prose :global(ol){margin:0 0 15px;padding-left:1.5em}.prose :global(li){margin:4px 0}.prose :global(a){color:var(--green);text-decoration:underline;text-underline-offset:3px}.prose :global(blockquote){border-left:2px solid var(--line);background:var(--soft);padding:11px 16px;margin:0 0 16px;font-size:12px}.prose :global(blockquote p:last-child){margin-bottom:0}.prose :global(:not(pre) > code){background:var(--soft);padding:1px 4px;font-size:.9em;overflow-wrap:anywhere}.prose :global(pre){font-size:12px;line-height:1.6;overflow-x:auto;padding:15px 18px;border:1px solid var(--line);border-radius:2px;margin:12px 0 18px}.prose :global(pre code){font-size:inherit}.prose :global(table){border-collapse:collapse;width:100%;font-size:12px;margin:14px 0;display:block;overflow-x:auto}.prose :global(th),.prose :global(td){border-bottom:1px solid var(--line);padding:7px 9px;text-align:left}.prose :global(th){background:var(--soft)}
  .page-nav{margin:5px 30px 0;padding:18px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.page-nav a{display:flex;flex-direction:column;gap:4px;font-size:12px}.page-nav a:last-child{text-align:right}.page-nav span{color:var(--muted);font-size:11px}.page-nav strong{font-size:13px}.page-nav a:hover strong{color:var(--accent)}
  @media(max-width:850px){.reading-grid{grid-template-columns:1fr;gap:0}.toc{display:none}.prose{max-width:790px;margin:auto;width:100%}}
  @media(max-width:600px){.rust-header,.reading-grid,.page-nav{margin-left:18px;margin-right:18px}.rust-header{padding:35px 0 25px}.rust-header h1{font-size:29px}.reading-grid{padding-top:22px}.prose{font-size:13px}.prose :global(h2){font-size:20px}.prose :global(h3){font-size:16px}.page-nav{gap:10px}.page-nav strong{font-size:12px}}
</style>
