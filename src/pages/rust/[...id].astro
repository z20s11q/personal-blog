---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const sections = (await getCollection('rust')).sort((a, b) => a.data.order.localeCompare(b.data.order));
  return sections.map((section, index) => ({
    params: { id: section.id },
    props: { section, previous: sections[index - 1] ?? null, next: sections[index + 1] ?? null },
  }));
}

const { section, previous, next } = Astro.props;
const { Content, headings } = await render(section);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const rustBase = `${base}rust/`;
const canonical = new URL(`${rustBase}${section.id}/`, Astro.site).href;
---

<BaseLayout title={section.data.title} description={`Rust 编程语言（精简版）：${section.data.title}`} canonical={canonical}>
  <header class="page-head">
    <div class="eyebrow">编程学习 / Rust</div>
    <h1>{section.data.title}</h1>
    <div class="page-meta">
      <span>Rust 编程语言（精简版）</span>
      <span>{section.data.chapter === null ? '附录' : `第 ${section.data.chapter} 章`}</span>
      <a href={`${rustBase}#section-${section.id}`}>在连续阅读页中打开 →</a>
    </div>
  </header>
  <div class="reading-grid">
    <aside class="toc" aria-label="本节目录">
      <div class="toc-inner">
        <span class="toc-label">本节目录</span>
        {toc.length ? toc.map((heading) => <a href={`#${heading.slug}`} class:list={{ sub: heading.depth === 3 }}>{heading.text}</a>) : <p>本节是章节导言。</p>}
        <a class="all-chapters" href={rustBase}>全部章节 →</a>
      </div>
    </aside>
    <article class="prose"><Content /></article>
  </div>
  <nav class="page-nav" aria-label="相邻章节">
    {previous ? <a href={`${rustBase}${previous.id}/`}><span>← 上一节</span><strong>{previous.data.title}</strong></a> : <div />}
    {next ? <a href={`${rustBase}${next.id}/`}><span>下一节 →</span><strong>{next.data.title}</strong></a> : <div />}
  </nav>
</BaseLayout>

<style>
  .page-meta a { color: var(--accent); font-weight: 600; }
  .reading-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: 56px;
    margin: 0 var(--page-x);
    padding: 40px 0;
  }
  .toc-inner { position: sticky; top: 28px; display: flex; flex-direction: column; max-height: calc(100vh - 56px); overflow-y: auto; }
  .toc-label { margin-bottom: 12px; color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .06em; }
  .toc a { padding: 6px 8px 6px 14px; border-left: 2px solid var(--line); color: var(--muted); font-size: 14px; line-height: 1.5; }
  .toc a.sub { padding-left: 26px; font-size: 13.5px; }
  .toc a:hover { color: var(--ink); border-left-color: var(--ink); }
  .toc p { margin: 0; color: var(--muted); font-size: 14px; }
  .toc .all-chapters { margin-top: 16px; padding-left: 0; border: 0; color: var(--ink); font-weight: 700; }

  .page-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0 var(--page-x);
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .page-nav a { display: flex; flex-direction: column; gap: 4px; padding: 14px 18px; border: 1px solid var(--line); border-radius: 8px; transition: border-color .15s; }
  .page-nav a:last-child { text-align: right; }
  .page-nav a:hover { border-color: var(--accent); }
  .page-nav span { color: var(--muted); font-size: 14px; }
  .page-nav strong { font-size: 16px; }

  @media (max-width: 900px) {
    .reading-grid { grid-template-columns: 1fr; gap: 0; }
    .toc { display: none; }
  }
  @media (max-width: 760px) {
    .reading-grid { padding: 28px 0; }
    .page-nav { grid-template-columns: 1fr; gap: 12px; }
    .page-nav a:last-child { text-align: left; }
  }
</style>
