---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { domainLabel } from '../../data/domains';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(`${base}articles/${article.id}/`, Astro.site).href;
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN');
---

<BaseLayout title={article.data.title} description={article.data.description} canonical={canonical} progress>
  <header class="page-head">
    <div class="eyebrow">{article.data.category}</div>
    <h1>{article.data.title}</h1>
    <p>{article.data.description}</p>
    <div class="article-tags">{article.data.tags.map((tag) => <a href={`${base}tags/${tag}/`}>{domainLabel(tag)}</a>)}</div>
    <div class="page-meta">
      <span>发布于 {formatDate(article.data.publishedAt)}</span>
      <span>复核于 {formatDate(article.data.reviewedAt)}</span>
      <span>约 {article.data.readingMinutes} 分钟</span>
    </div>
  </header>
  <div class="article-grid">
    <aside class="toc" aria-label="文章目录">
      <div class="toc-sticky">
        <span class="toc-label">本篇目录</span>
        {toc.map((heading) => <a href={`#${heading.slug}`} data-toc={heading.slug} data-level={heading.depth}>{heading.text}</a>)}
        <a class="back-link" href={`${base}articles/`}>← 全部文章</a>
      </div>
    </aside>
    <article class="prose" data-pagefind-body>
      <Content />
    </article>
  </div>
  <section class="article-end">
    <div class="eyebrow">继续学习</div>
    <h2>从资料出发，建立自己的判断。</h2>
    <p>回到原始来源、记录失败案例，并在下一次复盘里修正假设。</p>
    <a class="button" href={`${base}resources/`}>查看资料索引 <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<script>
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]')].map((link) => [link.dataset.toc!, link]),
  );
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  const setActive = () => {
    const current = targets.filter((el) => el.getBoundingClientRect().top < innerHeight * 0.3).at(-1) ?? targets[0];
    links.forEach((link, id) => link.classList.toggle('active', id === current?.id));
  };
  let queued = false;
  addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; setActive(); }); }
  }, { passive: true });
  setActive();
</script>

<style>
  .article-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .article-tags a { padding: 2px 10px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); font-size: 13px; }
  .article-tags a:hover { color: var(--accent); border-color: var(--accent); }
  .article-grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 760px);
    gap: 56px;
    margin: 0 var(--page-x);
    padding: 40px 0;
  }
  .toc-sticky { position: sticky; top: 28px; max-height: calc(100vh - 56px); overflow-y: auto; scrollbar-width: thin; display: flex; flex-direction: column; }
  .toc-label { margin-bottom: 12px; color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .06em; }
  .toc a[data-toc] {
    padding: 7px 0 7px 14px;
    border-left: 2px solid var(--line);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
    transition: color .15s, border-color .15s;
  }
  .toc a[data-toc]:hover { color: var(--ink); }
  .toc a[data-level="3"] { padding-left: 28px; font-size: 13px; }
  .toc a.active { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }
  .back-link { margin-top: 18px; color: var(--ink); font-size: 14px; font-weight: 700; }
  .back-link:hover { color: var(--accent); }

  .article-end { margin: 0 var(--page-x); padding: 28px 32px; border-radius: 8px; background: var(--soft); }
  .article-end h2 { margin: 10px 0 4px; font-size: 22px; letter-spacing: -.02em; }
  .article-end p { margin: 0 0 18px; color: var(--muted); font-size: 16px; }

  @media (max-width: 900px) {
    .article-grid { grid-template-columns: 1fr; gap: 0; }
    .toc { display: none; }
  }
  @media (max-width: 760px) {
    .article-grid { padding: 28px 0; }
    .article-end { padding: 22px 20px; }
  }
</style>
