---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { domainLabel } from '../../data/domains';
import ReadingToc from '../../components/ReadingToc.astro';
import { getEntries } from '../../data/entries';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4).map((heading) => ({ id: heading.slug, text: heading.text, depth: heading.depth }));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(`${base}articles/${article.id}/`, Astro.site).href;
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN');

const entries = await getEntries(base);
const selfHref = `${base}articles/${article.id}/`;
const series = entries.filter((entry) => entry.category === article.data.category && entry.href.includes('/articles/'));
const position = series.findIndex((entry) => entry.href === selfHref);
const seriesNext = [...series.slice(position + 1), ...series.slice(0, position)];
const sameTags = entries.filter((entry) => entry.href !== selfHref && !seriesNext.includes(entry) && entry.tags.some((tag) => article.data.tags.includes(tag)));
const related = [...seriesNext, ...sameTags].slice(0, 4);
---

<BaseLayout title={article.data.title} description={article.data.description} canonical={canonical} progress>
  <header class="page-head">
    <div class="eyebrow">{article.data.category}</div>
    <h1>{article.data.title}</h1>
    <p>{article.data.description}</p>
    <div class="article-tags">{article.data.tags.map((tag) => <a href={`${base}tags/${tag}/`}>{domainLabel(tag)}</a>)}</div>
    <div class="page-meta">
      <span>发布于 {formatDate(article.data.publishedAt)}</span>
      <span>复核于 {formatDate(article.data.reviewedAt)}</span>
      <span>约 {article.data.readingMinutes} 分钟</span>
    </div>
  </header>
  <div class="article-grid">
    <ReadingToc items={toc} back={{ href: base, text: '← 返回首页' }} />
    <article class="prose" data-pagefind-body>
      <Content />
    </article>
  </div>
  {related.length > 0 && (
    <section class="article-end">
      <div class="eyebrow">{seriesNext.length > 0 ? `同系列 · ${article.data.category}` : '相关内容'}</div>
      <div class="related">
        {related.map((entry) => (
          <a class="related-card" href={entry.href}>
            <span>{entry.category}</span>
            <h3>{entry.title}</h3>
            <p>{entry.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const blocks = [...document.querySelectorAll<HTMLElement>('.prose pre.mermaid')];
  if (blocks.length) {
    const sources = blocks.map((block) => block.textContent ?? '');
    const { default: mermaid } = await import('mermaid');
    const render = async () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: dark ? 'dark' : 'neutral' });
      blocks.forEach((block, index) => {
        block.removeAttribute('data-processed');
        block.textContent = sources[index];
      });
      await mermaid.run({ nodes: blocks, suppressErrors: true });
    };
    await render();
    new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .article-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .article-tags a { padding: 2px 10px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); font-size: 13px; }
  .article-tags a:hover { color: var(--accent); border-color: var(--accent); }
  .article-grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 760px);
    gap: 56px;
    margin: 0 var(--page-x);
    padding: 40px 0;
  }
  .article-end { margin: 0 var(--page-x); padding: 28px 0 0; border-top: 1px solid var(--line); }
  .related { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
  .related-card { display: block; padding: 18px 20px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); transition: border-color .15s; }
  .related-card:hover { border-color: var(--accent); }
  .related-card span { color: var(--muted); font-size: 13px; }
  .related-card h3 { margin: 6px 0; font-size: 17px; line-height: 1.45; letter-spacing: -.015em; }
  .related-card:hover h3 { color: var(--accent); }
  .related-card p { display: -webkit-box; margin: 0; overflow: hidden; color: var(--muted); font-size: 14.5px; line-height: 1.7; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

  @media (max-width: 900px) {
    .article-grid { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-width: 760px) {
    .article-grid { padding: 28px 0; }
    .related { grid-template-columns: 1fr; }
  }
</style>
