---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryIndex from '../../components/EntryIndex.astro';
import { getEntries } from '../../data/entries';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const entries = await getEntries(base);
const canonical = new URL(base, Astro.site).href;
---

<BaseLayout title="全部文章" description="全部文章与笔记，按发布时间排列。" canonical={canonical}>
  <header class="page-head intro">
    <div class="eyebrow">Archive</div>
    <h1>全部文章</h1>
    <p>按发布时间排列，共 {entries.length} 篇。左侧按领域筛选。</p>
  </header>
  <EntryIndex all={entries} active="all" />
</BaseLayout>

<style>
  .intro { padding-bottom: 12px; }
</style>
