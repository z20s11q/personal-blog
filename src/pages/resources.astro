---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  { name: '原始理论', note: '优先读原作者，再用中文解释交叉理解。', items: [
    { title: 'Brooks Trading Course', subtitle: 'Al Brooks · 英文 · 原始课程目录与免费文章', href: 'https://www.brookstradingcourse.com/trade-price-action/', tag: '原始来源', detail: '逐根 K 线、市场周期、趋势、区间与突破。付费课程并非起步所必需。' },
    { title: 'Trading Price Action 三部曲', subtitle: 'Al Brooks · 英文 · 出版书籍', href: 'https://www.brookstradingcourse.com/price-action-trading-books/', tag: '原始来源', detail: '趋势、交易区间、反转。内容密集，建议配合图表练习。' },
    { title: 'MarketLife / Adam Grimes', subtitle: '英文 · 免费课程与市场结构', href: 'https://www.marketlife.com/', tag: '交叉验证', detail: '强调统计、计划和独立思考；平台也有收费服务。' },
    { title: 'YourTradingCoach', subtitle: 'Lance Beggs · 英文 · 原创文章', href: 'https://yourtradingcoach.org/', tag: '案例复盘', detail: '市场结构、受困交易者和复盘方法；需自行验证可执行性。' },
  ] },
  { name: '中文讲解与案例', note: '学习价值与长期盈利能力分开评价。', items: [
    { title: '方方土 PriceAction', subtitle: '中文 · YouTube 原频道', href: 'https://www.youtube.com/channel/UC-CckeotGQCZigg3nETreCQ', tag: '盘中讲解', detail: 'Brooks 课程翻译者；有盘中视频及课程推广链接。完整净收益未独立核验。' },
    { title: '方方土 Bilibili 原上传', subtitle: '中文 · Bilibili', href: 'https://www.bilibili.com/video/BV1bs421M7Q5/', tag: '视频案例', detail: '从具体交易视频观察分析过程，勿以单次结果推断长期表现。' },
    { title: '太妃的市場朗讀', subtitle: '中文 · 作者网站与课程', href: 'https://tefistudio.com/zh', tag: '体系课程', detail: '适合作为第二种中文讲法；有付费内容，连续净收益未核验。' },
    { title: '线索c @cluec3', subtitle: '中文 · X 原账号', href: 'https://x.com/cluec3', tag: '观察名单', detail: '有加密市场事前情景讨论；存在交易所返佣关系，全部交易未核验。' },
  ] },
  { name: '市场机制与后续订单流', note: '先弄清楚数据代表什么，再看工具。', items: [
    { title: 'CME 期货交易者指南', subtitle: '交易所 · 英文 · 市场深度和订单类型', href: 'https://www.cmegroup.com/education/files/a-traders-guide-to-futures.pdf', tag: '市场机制', detail: '理解期货限价单、市价单、盘口深度与执行边界。' },
    { title: 'CME 流动性研究', subtitle: '交易所 · 英文 · 订单簿深度限制', href: 'https://www.cmegroup.com/education/articles-and-reports/assessing-liquidity', tag: '研究资料', detail: '提醒不能只用可见挂单量判断真实流动性。' },
    { title: 'Bookmap Academy', subtitle: '工具商 · 英文 · 订单流基础', href: 'https://bookmap.com/learning-center/en/market-mechanics/platform/default/academy', tag: '工具教程', detail: '可学习成交与流动性可视化；教学材料不构成策略收益证明。' },
  ] },
];
---

<BaseLayout title="资料索引" description="价格行为学原始教材、中文创作者、实战案例和订单流基础资料。">
  <header class="page-head">
    <div class="eyebrow">Source library</div>
    <h1>资料索引</h1>
    <p>从来源与证据入手，把值得读的内容放在一起。所有评级针对公开材料的可核验程度，不代表作者的真实盈利能力。</p>
    <div class="legend"><span><b>原始来源</b>优先建立术语</span><span><b>案例复盘</b>观察决策过程</span><span><b>观察名单</b>暂不判断收益</span></div>
  </header>
  <div class="resource-groups" data-pagefind-body>
    {groups.map((group, groupIndex) => (
      <section class="resource-group">
        <div class="group-title">
          <span>{String(groupIndex + 1).padStart(2, '0')}</span>
          <div><h2>{group.name}</h2><p>{group.note}</p></div>
        </div>
        <div class="resource-list">
          {group.items.map((item) => (
            <a class="resource-card" href={item.href} target="_blank" rel="noopener noreferrer">
              <div class="resource-top"><span class="resource-tag">{item.tag}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
              <h3>{item.title}</h3>
              <p class="resource-subtitle">{item.subtitle}</p>
              <p class="resource-detail">{item.detail}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <div class="resource-caveat"><strong>筛选原则</strong><p>只展示经核对的原始链接。课程营销、翻译搬运、收益截图和社区推荐分别标注。若要宣称“长期有效”，仍需完整交易记录、成本和独立复核。</p></div>
</BaseLayout>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 20px; color: var(--muted); font-size: 14px; }
  .legend b { margin-right: 6px; color: var(--ink); }

  .resource-groups { margin: 0 var(--page-x); }
  .resource-group { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; padding: 36px 0; border-bottom: 1px solid var(--line); }
  .group-title { display: flex; gap: 12px; align-items: flex-start; }
  .group-title > span { margin-top: 4px; color: var(--accent); font-size: 13px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .group-title h2 { margin: 0; font-size: 19px; letter-spacing: -.02em; }
  .group-title p { margin: 6px 0 0; color: var(--muted); font-size: 14px; line-height: 1.7; }

  .resource-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .resource-card {
    display: flex;
    flex-direction: column;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color .15s, transform .15s;
  }
  .resource-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .resource-top { display: flex; justify-content: space-between; align-items: center; }
  .resource-tag { padding: 1px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 12.5px; font-weight: 600; }
  .card-arrow { color: var(--muted); font-size: 16px; }
  .resource-card:hover .card-arrow { color: var(--accent); }
  .resource-card h3 { margin: 12px 0 4px; font-size: 17px; line-height: 1.45; letter-spacing: -.015em; }
  .resource-subtitle { margin: 0 0 8px; color: var(--muted); font-size: 13.5px; }
  .resource-detail { margin: 0; color: var(--text); font-size: 15px; line-height: 1.7; }

  .resource-caveat { display: flex; gap: 20px; align-items: baseline; margin: 32px var(--page-x) 0; padding: 20px 24px; border-radius: 8px; background: var(--soft); }
  .resource-caveat strong { white-space: nowrap; font-size: 15px; }
  .resource-caveat p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.75; }

  @media (max-width: 960px) {
    .resource-group { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 640px) {
    .resource-group { padding: 28px 0; }
    .resource-list { grid-template-columns: 1fr; gap: 12px; }
    .resource-caveat { display: block; padding: 18px 20px; }
    .resource-caveat p { margin-top: 6px; }
  }
</style>
