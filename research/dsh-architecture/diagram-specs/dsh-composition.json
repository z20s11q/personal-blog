  "cards": [
    {
      "dot": "amber",
      "title": "叠加规则",
      "items": [
        "补丁按 bundle → profile → 用户 → 启动参数 → 遥测关闭的顺序叠加",
        "同 id 的行按字段覆盖，覆盖是整字段替换，不做深合并",
        "新 id 插入到指定位置；叠加结果就是 Loader 要装配的行表"
      ]
    },
    {
      "dot": "cyan",
      "title": "一切都是行",
      "items": [
        "每一行是一个插件：导入模块、挂载到作用域、按依赖顺序启动",
        "Agent loop、LLM 适配器、工具、UI 都是行；换掉一行就是换掉一个实现",
        "服务在插件里自注册，依赖它的插件在服务就绪后才启动"
      ]
    },
    {
      "dot": "violet",
      "title": "热重载",
      "items": [
        "只有 Web 与桌面挂载 HMR；CLI 与 headless 不重载",
        "补丁文件变化后重算整张行表，只更新变化的行",
        "标记为易变的字段原地生效，其他字段变化会重挂整行"
      ]
    },
    {
      "dot": "emerald",
      "title": "预设与代次",
      "items": [
        "预设是一组按会话挂载的行，决定这个会话的工具、人设和策略",
        "预设更新产生新代次；已有会话继续引用旧代次，新会话用新代次",
        "旧代次的引用计数归零后才卸载"
      ]
    }
  ]
