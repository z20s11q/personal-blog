  "cards": [
    {
      "dot": "violet",
      "title": "审批只有一种结果能放行",
      "items": [
        "执行前钩子返回询问时才找审批服务；没有组合审批服务就直接拒绝",
        "审批结果只有允许一次、拒绝、取消、无通道四种，没有“总是允许”",
        "守卫在允许之后求值，只能拒绝，不能替别人放行",
        "base 包里没有按工具、路径或命令前缀的规则引擎"
      ]
    },
    {
      "dot": "cyan",
      "title": "沙箱在工具体内部",
      "items": [
        "参数校验、沙箱模式选择、提权审批都发生在工具体里，不在执行前钩子",
        "沙箱只限制文件写；读文件、网络、进程不受限",
        "模型带 sandbox_permissions 重试时才申请提权，一次放宽到最窄的更宽模式",
        "提权被拒时工具体抛错，提示模型停止并解释"
      ]
    },
    {
      "dot": "rose",
      "title": "失败的两种形态",
      "items": [
        "命令被沙箱拦截、非零退出、超时都是普通结果加标记，不算错误",
        "被拦截的结果附带提权提示，告诉模型可以带参数重试同一条命令",
        "沙箱后端不可用时返回错误，命令不执行，绝不静默放行"
      ]
    },
    {
      "dot": "amber",
      "title": "顺序与并行",
      "items": [
        "登记、执行前钩子、审批、守卫按模型顺序串行",
        "只有执行包装层与工具体在滚动池里并行",
        "执行后钩子与结果提交按模型顺序进行；拒绝结果同样经过执行后钩子"
      ]
    }
  ]
