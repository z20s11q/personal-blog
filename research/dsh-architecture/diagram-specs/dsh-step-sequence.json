  "cards": [
    {
      "dot": "cyan",
      "title": "请求从日志推导",
      "items": [
        "驱动器先把系统提示词变化和用户消息写进日志，再从日志推导请求",
        "每次尝试（含重试）都先刷新运行时上下文；有变化时先追加一条用户消息",
        "请求由 buildRequest 直接取日志推导的消息并冻结，运行时不另做核对",
        "因此取同一段日志前缀，就能重建出这次尝试交给 LLM 运行时的请求（适配器之后的序列化不在日志里）"
      ]
    },
    {
      "dot": "amber",
      "title": "采样期间不执行工具",
      "items": [
        "流式增量只发给订阅者，不写日志",
        "结束块到达后一次性写入 assistant/message",
        "工具在流结束后才调度；与 Codex、oh-my-pi 的边流边执行不同"
      ]
    },
    {
      "dot": "violet",
      "title": "工具调度与提交",
      "items": [
        "独占工具单独成批，可并行工具组成滚动池，并发上限默认 10",
        "每次启动前重新读取并发模式，注册表变化会影响尚未启动的调用",
        "结果按模型顺序提交；工具附带的上下文进入 next-step 收件箱"
      ]
    },
    {
      "dot": "rose",
      "title": "取消时",
      "items": [
        "已启动的调用等其结束并按顺序提交",
        "未启动的调用补写一对调用与结果，保证配对完整",
        "流被取消时，已生成的内容写成中断消息"
      ]
    }
  ]
