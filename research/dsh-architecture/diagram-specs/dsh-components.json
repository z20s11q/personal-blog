  "cards": [
    {
      "dot": "cyan", "title": "所有入口都是 agent 工厂的适配器",
      "items": [
        "Web 与桌面经会话控制器，SDK、ACP、Webhook、定时任务、子 agent 直接调用同一个创建 / 恢复接口",
        "取得 agent 之后只调 followup / steer / inject / cancel，没有入口绕开主循环",
        "注册表只在取得 agent 时参与；运行时它提供“当前是哪个 agent 在执行”的作用域"
      ]
    },
    {
      "dot": "violet", "title": "持久状态只有日志",
      "items": [
        "收件箱、turn 编号、重试计数、计划模式都是日志投影",
        "每次请求从日志推导并冻结；不变量插件在分发前核对“请求 == 推导结果”",
        "追加是同步的，不做 I/O；持久化后端在检查点统一落盘"
      ]
    },
    {
      "dot": "amber", "title": "策略都在插件里",
      "items": [
        "驱动器只有 step 前、请求配置、请求出错、turn 即将结束四个扩展点",
        "重试、压缩、检查点、hooks、目标驱动都挂在这四个点上",
        "沙箱模式在工具体内部决定；审批只在模型申请提权时发生"
      ]
    },
    {
      "dot": "rose", "title": "与 DeepSeek 服务端的协同",
      "items": [
        "系统提示词中途更新、对话中途增删工具需要服务端支持",
        "请求体默认附带在用插件清单和会话日志增量，不占模型 token",
        "组合内核装配出整棵插件树；连 agent loop 本身也是其中一行"
      ]
    }
  ]
}
