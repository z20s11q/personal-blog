    "cards":  [
                  {
                      "dot":  "violet",
                      "title":  "审批要求与来源",
                      "items":  [
                                    "工具可以自定审批要求；否则按审批策略推导：从不询问 → 跳过；按需 → 文件系统受限时要审批；除非可信 → 总是审批",
                                    "细粒度策略关闭了沙箱审批时，“要审批”直接变成“禁止”",
                                    "开启严格自动审查时，“跳过”也会送审",
                                    "审批来源依次为：权限请求 hook → Guardian 自动审查 → 用户"
                                ]
                  },
                  {
                      "dot":  "cyan",
                      "title":  "沙箱选择",
                      "items":  [
                                    "命令规则判定完全可信，或工具请求提升权限时，首次尝试就不带沙箱",
                                    "存在“禁止读取”路径时永远不脱离沙箱，否则这些限制会失效",
                                    "由执行端自己施加沙箱的工具，编排器不再套一层"
                                ]
                  },
                  {
                      "dot":  "rose",
                      "title":  "不升级、直接失败的情况",
                      "items":  [
                                    "失败原因不是沙箱拒绝",
                                    "被网络策略拒绝，但无法转成一次网络审批",
                                    "工具声明失败时不升级",
                                    "审批策略不允许请求无沙箱执行（按需策略下可审批的网络拒绝除外）",
                                    "存在禁止读取路径，且不是网络拒绝"
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "升级前能否免审",
                      "items":  [
                                    "免审条件：未开启严格自动审查，且（本次已经批准过或策略为从不询问），且不是网络拒绝",
                                    "严格自动审查的批准只覆盖沙箱内那次尝试，脱离沙箱必须重新审查",
                                    "网络拒绝的重试原因写明被拦的主机"
                                ]
