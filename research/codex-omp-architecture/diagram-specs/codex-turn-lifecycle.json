  "cards": [
    {
      "dot": "cyan", "title": "继续条件只有一条",
      "items": [
        "需要继续 = 模型需要继续 ∨ 有待并入输入",
        "模型需要继续：发出了工具调用、工具要求直接回复模型、响应声明回合未结束、流被用户输入抢占",
        "工具续跑与用户插话走同一条回边"
      ]
    },
    {
      "dot": "amber", "title": "turn 中途压缩的两个入口",
      "items": [
        "需要继续，且模型请求了新窗口或 token 到达上限",
        "采样报上下文超窗，且自动审查预算已耗尽；每步最多压缩一次",
        "两者都把指令、环境、世界状态重新注入到最后一条用户消息之前",
        "压缩刚结束时不急于并入插话，除非这一步是被抢占的"
      ]
    },
    {
      "dot": "violet", "title": "Stop hook 的三种结果",
      "items": [
        "阻止且给出续跑内容：记为一条用户消息，回到并入输入",
        "阻止但没有续跑内容：发警告并忽略这次阻止",
        "要求停止：直接结束，不做 turn 后压缩；放行时才检查 turn 后压缩阈值",
        "记忆整理这类无人值守会话被 Stop hook 拦下时直接报错"
      ]
    },
    {
      "dot": "rose", "title": "图中未单独画出的结束方式",
      "items": [
        "turn 被中止（例如用户中断）时，任何阶段都直接向上返回",
        "旧版 after-agent hook 可以在放行后结束 turn",
        "中途压缩后若 session-start hook 要求停止，turn 结束"
      ]
    }
  ]
