    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "一轮的主路径",
                      "items":  [
                                    "每轮开始先把待投递消息写入上下文，再重读配置、构造调用、过调用前闸门",
                                    "停止原因为“工具调用”或“正常停止”时都执行工具；只有“输出被截断”不执行",
                                    "模型给出暂停型停止（回合未结束）且没有工具调用时，最多续跑 8 次"
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "“不执行工具”的四种情况",
                      "items":  [
                                    "没有工具调用",
                                    "软要求未满足：调用都配“跳过”结果，下一轮强制调用必需工具；强制 3 次仍不满足就报错",
                                    "输出被截断：调用配占位结果，然后重采样",
                                    "已过截止时间：调用配“中止”结果，运行随即结束"
                                ]
                  },
                  {
                      "dot":  "violet",
                      "title":  "插话怎么进入下一轮",
                      "items":  [
                                    "采样期间经实时通道被模型收下的插话：下一轮只投递它们，其他排队消息等下一个边界",
                                    "否则：未被收下的实时插话 + 重新从队列取的插话；还在干活时再附上旁白",
                                    "外部中止时不从队列取消息，留给后续运行投递"
                                ]
                  },
                  {
                      "dot":  "rose",
                      "title":  "图中未单独画出的结束方式",
                      "items":  [
                                    "截止时间在各个检查点都会让运行直接结束",
                                    "工具把结果标为终止（例如子 agent 让出）时，不再发起下一次模型调用",
                                    "Harmony 泄漏：可截断恢复就续用，否则重采样；各最多 2 次，超过即报错"
                                ]
                  }
              ]
