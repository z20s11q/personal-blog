    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "所有前端共用一套协议",
                      "items":  [
                                    "终端 UI 和非交互执行也走会话协议，只是协议服务嵌在同一进程里",
                                    "引擎事件经协议服务变成 Thread / Turn / Item 通知；需要用户审批时，引擎通过协议向客户端发起请求",
                                    "审批回复作为 Op 回到分发器，唤醒正在等待的工具"
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "会话引擎的四层",
                      "items":  [
                                    "Op 分发器：串行处理外部操作，不等待 turn 完成",
                                    "任务管理：开启、替换、中止 turn，把插话写入活跃 turn；同一时刻一个活跃 turn；每个 turn 向子 agent 控制申请准入",
                                    "Turn 循环：决定是否继续、何时压缩、处理 Stop hook",
                                    "采样器：一次模型请求，负责重试、消费流事件、写入输出项、派发工具"
                                ]
                  },
                  {
                      "dot":  "rose",
                      "title":  "安全边界",
                      "items":  [
                                    "编排器只关心审批、沙箱与升级，不关心工具语义",
                                    "Guardian 按 turn 计数拒绝：连续拒绝 3 次，或最近 50 次中拒绝 10 次，就请求中断 turn（网络安全专用模型两个阈值都是 1）",
                                    "隔离执行按平台选沙箱，并叠加命令策略与网络代理"
                                ]
                  }
              ]
}